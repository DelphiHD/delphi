# delphi / HD Reports — environment variables
#
# Copy this file to .env.local and fill in values. .env.local is gitignored.
# Vercel: push these via `vercel env add` or the Vercel dashboard.
#
# Naming convention:
#   NEXT_PUBLIC_*  → safe to ship to the browser (URLs, anon keys, public IDs).
#   everything else → server-only. Never read in client components.
#
# Phase column indicates the earliest phase that needs the variable.
# A variable can be left blank locally until its phase begins.

# ─────────────────────────────────────────────────────────────────────────────
# App  (Phase 1)
# ─────────────────────────────────────────────────────────────────────────────

# The canonical URL of the deployed app. Used for OAuth callbacks, email links,
# and Stripe success_url construction. Local dev: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Shared secret that Vercel Cron passes in the Authorization header.
# Generate: `openssl rand -hex 32`. The cron route rejects requests without it.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase  (Phase 1)
# ─────────────────────────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard/project/<ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses RLS. NEVER ship to the browser. Only used by:
#   - lib/supabase/admin.ts (server-only)
#   - Edge Functions (`supabase/functions/*`)
SUPABASE_SERVICE_ROLE_KEY=

# Project ref (the alphanumeric subdomain piece of your Supabase URL).
# Used by `supabase link --project-ref=<ref>` and CI scripts.
SUPABASE_PROJECT_REF=

# ─────────────────────────────────────────────────────────────────────────────
# PostHog  (Phase 1) — client + server analytics
# ─────────────────────────────────────────────────────────────────────────────
# Project key and host are both public (safe to expose to the browser).
# Get from https://us.posthog.com/project/<id>/settings/project-details
# Real value for delphi: NEXT_PUBLIC_POSTHOG_KEY=phc_vTLudKFUz43k7ZmKXnH8KkHXnf3uQj87BwTANZPNdbg6

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic  (Phase 4)
# ─────────────────────────────────────────────────────────────────────────────
# Used ONLY by supabase/functions/invoke-llm. Never imported in app code.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hard cost ceiling per single invoke-llm call, in cents. If a single call
# would exceed this, invoke-llm aborts and writes an alert row. Default 80.
HARD_COST_CEILING_CENTS=80

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI  (Phase 3) — embeddings only
# ─────────────────────────────────────────────────────────────────────────────
# Used by ingest-markdown for text-embedding-3-small. No completion calls.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe  (Phase 2)
# ─────────────────────────────────────────────────────────────────────────────
# Test-mode keys for development; swap to live keys in Vercel for production.
# https://dashboard.stripe.com/test/apikeys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Webhook signing secret. Get from `stripe listen --forward-to ...` locally,
# or the dashboard's webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the chosen pricing model (Option A: three fixed-length reports).
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_DEEP=
STRIPE_PRICE_FULL=

# Phase 6 daily-letter upsell ($1 per day).
STRIPE_PRICE_DAILY_LETTER=

# ─────────────────────────────────────────────────────────────────────────────
# ElevenLabs  (Phase 5)
# ─────────────────────────────────────────────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice ID for Kaycee's cloned voice. Created during Phase 0 voice-clone session.
ELEVENLABS_VOICE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# HumanDesignHub  (Phase 4)
# ─────────────────────────────────────────────────────────────────────────────
# Chart calculation API. Free tier: 100 calls/month. Cache aggressively.
# Watch the cap once paying customers > ~50; consider self-hosted MCP service.
HD_HUB_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Resend  (Phase 5)
# ─────────────────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Domain must be verified in Resend before launch
# (DKIM + SPF + DMARC for deliverability).
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Notion  (Phase 3)
# ─────────────────────────────────────────────────────────────────────────────
# Create a Notion integration at https://www.notion.so/my-integrations
# Then "Connect to" the integration on the database that holds Kaycee's library.
NOTION_TOKEN=

# Database ID is the 32-char string in the database's URL, before `?v=`.
NOTION_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub  (Phase 3)
# ─────────────────────────────────────────────────────────────────────────────
# Used by the Notion-sync cron to commit generated markdown back to the repo.
# Classic PAT with `repo` scope, scoped to DelphiHD/delphi only.
# https://github.com/settings/tokens
GITHUB_PAT=

# Target repo for the markdown commits (the canonical content store).
GITHUB_REPO=DelphiHD/delphi

# ─────────────────────────────────────────────────────────────────────────────
# Vercel  (Phase 1) — only needed if you script Vercel from CI
# ─────────────────────────────────────────────────────────────────────────────
# Most local work uses `vercel link` + `vercel env`; these are not needed in
# .env.local for the app itself. Set them in CI secrets if scripting deploys.
# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
