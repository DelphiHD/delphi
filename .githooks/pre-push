#!/usr/bin/env bash
# Pre-push hook: refuse to push if any canonical doc listed in CLAUDE.md is
# missing or untracked. Catches the "I edited it locally and forgot to commit"
# drift. Keep this list in sync with the "Read first" sections of CLAUDE.md
# and AGENTS.md.
#
# To enable in a fresh clone: `git config core.hooksPath .githooks`
# (CLAUDE.md tells the agent to do this on first session.)

set -euo pipefail

required=(
  "CLAUDE.md"
  "AGENTS.md"
  "HD-Reports-Master-Plan.md"
  "docs/CONTEXT.md"
  "docs/INTENT.md"
  "docs/IDENTITY.md"
  "docs/VOICE.md"
  "docs/ARCHITECTURE.md"
  "docs/DECISIONS.md"
  "docs/STACK_PORTED.md"
  "docs/PHASE_1_HANDOFF.md"
  "docs/PHASE_4_HANDOFF.md"
)

missing=()
untracked=()

for f in "${required[@]}"; do
  if [[ ! -f "$f" ]]; then
    missing+=("$f")
    continue
  fi
  if ! git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
    untracked+=("$f")
  fi
done

if (( ${#missing[@]} + ${#untracked[@]} > 0 )); then
  echo "pre-push: canonical-doc check failed."
  if (( ${#missing[@]} > 0 )); then
    echo "  missing files:"
    printf '    - %s\n' "${missing[@]}"
  fi
  if (( ${#untracked[@]} > 0 )); then
    echo "  exists locally but not tracked (commit these first):"
    printf '    - %s\n' "${untracked[@]}"
  fi
  echo
  echo "Fix the list above, or update .githooks/pre-push, CLAUDE.md, and"
  echo "AGENTS.md together if a canonical doc is being intentionally retired."
  exit 1
fi

# No sentence reaches a client that Kaycee has not seen. On 2026-09-12 four of
# mine did, in one morning, and each one cost her a screenshot and a message
# telling me where it was. She asked the right question: "how are we going to
# stop it from happening?" Not by me remembering.
if command -v npx >/dev/null 2>&1; then
  if ! npx tsx scripts/copy-check.ts; then
    echo
    echo "pre-push: client copy check failed. Show her the sentences above."
    exit 1
  fi
fi

exit 0
