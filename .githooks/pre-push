#!/usr/bin/env bash
# Pre-push hook: refuse to push if any canonical doc listed in CLAUDE.md is
# missing or untracked. Catches the "I edited it locally and forgot to commit"
# drift. Keep this list in sync with the "Read first" sections of CLAUDE.md
# and AGENTS.md.
#
# To enable in a fresh clone: `git config core.hooksPath .githooks`
# (CLAUDE.md tells the agent to do this on first session.)

set -euo pipefail

required=(
  "CLAUDE.md"
  "AGENTS.md"
  "HD-Reports-Master-Plan.md"
  "docs/CONTEXT.md"
  "docs/INTENT.md"
  "docs/IDENTITY.md"
  "docs/VOICE.md"
  "docs/ARCHITECTURE.md"
  "docs/DECISIONS.md"
  "docs/STACK_PORTED.md"
  "docs/PHASE_1_HANDOFF.md"
  "docs/PHASE_4_HANDOFF.md"
)

missing=()
untracked=()

for f in "${required[@]}"; do
  if [[ ! -f "$f" ]]; then
    missing+=("$f")
    continue
  fi
  if ! git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
    untracked+=("$f")
  fi
done

if (( ${#missing[@]} + ${#untracked[@]} > 0 )); then
  echo "pre-push: canonical-doc check failed."
  if (( ${#missing[@]} > 0 )); then
    echo "  missing files:"
    printf '    - %s\n' "${missing[@]}"
  fi
  if (( ${#untracked[@]} > 0 )); then
    echo "  exists locally but not tracked (commit these first):"
    printf '    - %s\n' "${untracked[@]}"
  fi
  echo
  echo "Fix the list above, or update .githooks/pre-push, CLAUDE.md, and"
  echo "AGENTS.md together if a canonical doc is being intentionally retired."
  exit 1
fi

# Core files do not change without a written decision. On 2026-08-24 the sync
# changed how it stores relations inside a commit about chart links; the
# reports could not read the library from the next full sync until 2026-10-29,
# and nothing said so. A push that touches any of these must also add to
# docs/DECISIONS.md in the same push. Keep this list in step with the "ask"
# list in .claude/settings.json.
protected_re='^(scripts/sync-notion\.ts|lib/hd/chunks-source\.ts|lib/hd/library-names\.ts|lib/retrieval/|lib/chart/datapass\.ts|lib/chart/types\.ts|lib/report/|scripts/generate-report\.ts|scripts/add-client\.ts|lib/llm/core\.ts|lib/mybodygraph\.ts|lib/transit/sky\.ts|lib/render/mandala\.ts|supabase/migrations/|\.githooks/|\.claude/settings\.json)'
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  if [[ "$remote_sha" == "$zero" ]]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  changed=$(git diff --name-only "$range" 2>/dev/null || git show --name-only --format= "$local_sha")
  touched=$(printf '%s\n' "$changed" | grep -E "$protected_re" || true)
  if [[ -n "$touched" ]] && ! printf '%s\n' "$changed" | grep -qx "docs/DECISIONS.md"; then
    echo "pre-push: core files changed with no decision written down."
    printf '    - %s\n' $touched
    echo
    echo "Add an entry to docs/DECISIONS.md saying what changed, why, what else it"
    echo "touches, and that Kaycee approved it, then push again."
    exit 1
  fi
done

# No sentence reaches a client that Kaycee has not seen. On 2026-09-12 four of
# mine did, in one morning, and each one cost her a screenshot and a message
# telling me where it was. She asked the right question: "how are we going to
# stop it from happening?" Not by me remembering.
if command -v npx >/dev/null 2>&1; then
  if ! npx tsx scripts/copy-check.ts; then
    echo
    echo "pre-push: client copy check failed. Show her the sentences above."
    exit 1
  fi
fi

exit 0
