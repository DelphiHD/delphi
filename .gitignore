!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
.vercel/
dist/
build/
out/

# Env files. .env.example is committed; everything else is local-only.
.env
.env.local
.env.*.local
.env.development
.env.production

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/
*.swp

# Claude Code internal state (worktrees, session cache).
# Skills are tracked; everything else under .claude is local.
.claude/*
!.claude/skills/
!.claude/settings.json

# Logs and pipes
*.log
.pull.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test artifacts
coverage/
test/results/

# Supabase local dev
supabase/.temp/
supabase/.branches/

# Local sync checkpoints (extracted Notion content, not for git)
.cache/
