# Dependencies
# No trailing slash. A pattern ending in / matches a directory and nothing
# else, so it did not match the node_modules SYMLINK that each worktree keeps
# pointing at the main clone's copy. On 2026-10-05 a git add -A in a worktree
# committed that symlink, the daily pull laid it down in ~/delphi where it
# pointed at itself, and the install was gone.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
.vercel/
dist/
build/
out/

# Env files. .env.example is committed; everything else is local-only.
.env
.env.local
.env.*.local
.env.development
.env.production

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/
*.swp

# Claude Code internal state (worktrees, session cache).
# Skills are tracked; everything else under .claude is local.
.claude/*
!.claude/skills/
!.claude/settings.json

# Logs and pipes
*.log
.pull.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test artifacts
coverage/
test/results/

# Supabase local dev
supabase/.temp/
supabase/.branches/

# Local sync checkpoints (extracted Notion content, not for git)
.cache/
.vercel

# never a copy of the secrets either
.env*.backup-*
.env.local.backup*
